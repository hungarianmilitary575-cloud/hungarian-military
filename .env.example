# Másold át .env néven és töltsd ki a Discord Developer Portal adataival.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
SESSION_SECRET=CSERELD_LE_EGY_HOSSZU_VELETLEN_TITOKRA
BASE_URL=http://localhost:3000
PORT=3000
# Opcionális: rangazonosító -> megjelenítési név, JSON formában
# ROLE_LABELS={"123456789012345678":"Tulajdonos","987654321098765432":"Admin"}
DISCORD_BOT_TOKEN=

# FiveM: a szerver kódját majd később add meg (pl. abc123)
FIVEM_SERVER_ID=
FIVEM_JOIN_URL=

# Saját Discord felhasználói ID-k vesszővel elválasztva: csak ők láthatják az admin rendeléseket
# Founder ID-k a szerverben rögzítve; ez a változó nem szükséges.
# Banki átutalás adatai – NE add meg addig, amíg nincs hivatalos számlaszám
BANK_RECIPIENT=
BANK_ACCOUNT=
# FiveM utolsó restart ISO 8601 formátumban, később automatikus integrációra cserélhető
# Példa: 2026-11-07T18:00:00+01:00
LAST_RESTART_AT=

# Spotify Developer Dashboard -> Client ID / Client Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
